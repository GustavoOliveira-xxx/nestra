+  font-size: clamp(26px, 3.2vw, 40px);
+  font-weight: 600;
+  line-height: 1.08;
+  letter-spacing: var(--tracking-tight);
+}
+
+.today-hero__line {
+  font-size: var(--fs-md);
+  color: var(--text-2);
+  line-height: 1.5;
+  max-width: 48ch;
+}
+
+.today-hero__stats {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: var(--s-5);
+  margin-top: var(--s-1);
+}
+.today-hero__stat { display: flex; flex-direction: column; gap: 1px; }
+.today-hero__stat-n {
+  font-family: var(--font-display);
+  font-size: var(--fs-2xl);
+  font-weight: 600;
+  line-height: 1;
+  color: var(--text);
+  font-variant-numeric: tabular-nums;
+}
+.today-hero__stat-l {
+  font-family: var(--font-mono);
+  font-size: var(--fs-micro);
+  letter-spacing: .1em;
+  text-transform: uppercase;
+  color: var(--text-4);
+}
+.today-hero__stat--overdue .today-hero__stat-n { color: var(--overdue); }
+
+.today-hero__actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-2); }
+
+/* Plano B em CSS: a própria imagem empilhada em profundidade */
+.today-hero__stage .logo-css3d { z-index: 3; }
+
+@media (max-width: 860px) {
+  .today-hero {
+    grid-template-columns: 1fr;
+    gap: var(--s-3);
+    padding: var(--s-4);
+    text-align: center;
+  }
+  .today-hero__stage  { height: clamp(140px, 34vw, 186px); }
+  .today-hero__body   { align-items: center; gap: var(--s-2); }
+  .today-hero__title  { font-size: clamp(22px, 5.6vw, 30px); }
+  .today-hero__line   { font-size: var(--fs-sm); }
+  .today-hero__stats,
+  .today-hero__actions { justify-content: center; }
+
+  /* Os números cabem numa linha só: quebrar em duas empurrava a caixa
+     de captura para fora da primeira tela, que é justo o que ela não
+     pode fazer — capturar precisa estar à mão. */
+  .today-hero__stats   { gap: var(--s-4); flex-wrap: nowrap; }
+  .today-hero__stat    { align-items: center; }
+  .today-hero__stat-n  { font-size: var(--fs-xl); }
+  .today-hero__actions { margin-top: 0; }
+}
+
+[data-motion='reduced'] .today-hero::before,
+[data-motion='reduced'] .today-hero::after,
+[data-motion='reduced'] .today-hero__aura,
+[data-motion='reduced'] .today-hero__floor,
+[data-motion='reduced'] .today-hero__orbit span { animation: none; }
+
